<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plan du site : les pages stables.

  Les offres d'emploi et les pages carrière changent tous les jours ; les lister ici
  obligerait à republier le front à chaque nouvelle annonce. Elles sont servies par le
  backend, qui les connaît : /api/v1/public/sitemap.xml, déclaré dans robots.txt.

  « priority » et « changefreq » sont des indications, pas des ordres : Google les ignore
  largement depuis des années. Ce qui compte réellement ici, c'est que chaque adresse
  indexable soit listée une fois, avec le même domaine que l'adresse canonique de la page.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <url>
    <loc>https://skulvicv.cloud/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="fr-FR" href="https://skulvicv.cloud/"/>
    <xhtml:link rel="alternate" hreflang="fr-CI" href="https://skulvicv.cloud/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://skulvicv.cloud/"/>
  </url>

  <url>
    <loc>https://skulvicv.cloud/offres</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>https://skulvicv.cloud/tarifs</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <url>
    <loc>https://skulvicv.cloud/inscription-entreprise</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

</urlset>
