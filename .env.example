#  Base de données
DB_HOST=postgres
DB_PORT=5432
DB_NAME=skulvi
DB_USER=skulvi
DB_PASSWORD=
DB_EXPOSED_PORT=5433
APP_PORT=8080

#  Analyse de CV (Ollama auto-hébergé)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b

#  Sécurité
#  JWT_SECRET : 32 caractères minimum, sinon l'application refuse de démarrer.
#  Générer avec : openssl rand -base64 48
JWT_SECRET=
#  Durée de validité du jeton, en minutes. 480 = une journée de travail : un recruteur ne doit
#  pas être déconnecté toutes les heures en pleine session de tri.
JWT_EXPIRATION_MINUTES=480

#  Compte administrateur de la plateforme Skulvi (pas un client).
#  Sert à gérer les abonnements. Il n'appartient à aucune organisation et n'a donc accès à
#  aucune candidature ni aucun CV de client.
ADMIN_EMAIL=
ADMIN_PASSWORD=

#  Adresse publique du site. Sert aux retours de paiement : en production, le vrai
#  domaine, sinon le client est renvoyé sur sa propre machine après avoir payé.
PUBLIC_URL=http://localhost:4200

#  Origines autorisées par le navigateur, séparées par des virgules.
#  Une entrée contenant « * » est traitée comme un motif.
#  En production : le vrai domaine, et rien d'autre.
#  En local : inutile de s'en occuper, le mandataire du serveur de développement
#  (frontSkulvi/proxy.conf.cjs) met le front et l'API sur la même origine.
CORS_ORIGIN=http://localhost:4200,http://localhost:*

#  ---------------------------------------------------------------- Paiement (Stripe)
#
#  Compte en France : Stripe y est pleinement supporté, facturation en EUR, et la TVA
#  européenne se gère depuis Stripe Tax si besoin.
#
#  Laisser STRIPE_ENABLED=false tant que les clés ne sont pas renseignées : l'application
#  démarre normalement et propose un contact au lieu d'un bouton inopérant.
STRIPE_ENABLED=false

#  Mode test : sk_test_… / whsec_… — mode réel : sk_live_…
#  Ne jamais committer ces valeurs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

#  Un identifiant de tarif par plan payant, créés dans le tableau de bord Stripe en
#  « Produit » → « Tarif récurrent mensuel », en EUR :
#    Starter    9 €/mois
#    Pro       14 €/mois
#    Illimité  20 €/mois
#  Les clés ci-dessous correspondent aux noms de l'enum Plan en minuscules : c'est ce qui
#  permet au webhook de retrouver le plan d'un abonnement. Ne pas les renommer.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

#  Documentation de l'API.
#  À laisser sur false en production : Swagger décrit toute la surface d'attaque de l'API.
SWAGGER_ENABLED=true

#  File d'analyse
#  QUEUE_INITIAL_DELAY_MS laisse à Ollama le temps de démarrer avant la première analyse.
QUEUE_POLL_MS=3000
QUEUE_INITIAL_DELAY_MS=10000
