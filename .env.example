#  Base de données
DB_HOST=postgres
DB_PORT=5432
DB_NAME=skulvi
DB_USER=skulvi
DB_PASSWORD=
DB_EXPOSED_PORT=5433
APP_PORT=8080

#  Analyse de CV (Ollama auto-hébergé)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b

#  Sécurité
#  JWT_SECRET : 32 caractères minimum, sinon l'application refuse de démarrer.
#  Générer avec : openssl rand -base64 48
JWT_SECRET=
#  Durée de validité du jeton, en minutes. 480 = une journée de travail : un recruteur ne doit
#  pas être déconnecté toutes les heures en pleine session de tri.
JWT_EXPIRATION_MINUTES=480

#  Compte administrateur de la plateforme Skulvi (pas un client).
#  Sert à gérer les abonnements. Il n'appartient à aucune organisation et n'a donc accès à
#  aucune candidature ni aucun CV de client.
ADMIN_EMAIL=
ADMIN_PASSWORD=

#  Origines autorisées par le navigateur, séparées par des virgules.
#  En production, mettre le vrai domaine et rien d'autre.
CORS_ORIGIN=http://localhost:4200

#  Documentation de l'API.
#  À laisser sur false en production : Swagger décrit toute la surface d'attaque de l'API.
SWAGGER_ENABLED=true

#  File d'analyse
#  QUEUE_INITIAL_DELAY_MS laisse à Ollama le temps de démarrer avant la première analyse.
QUEUE_POLL_MS=3000
QUEUE_INITIAL_DELAY_MS=10000
